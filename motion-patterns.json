      "frequency": "occasional",
      "purpose": "spatial-consistency",
      "trigger": "insert-remove-reorder",
      "properties": ["opacity", "transform"],
      "durationToken": "standard",
      "easingToken": "move",
      "reducedMotion": "instant-reflow-with-focus-preservation",
