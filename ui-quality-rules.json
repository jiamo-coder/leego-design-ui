{
  "standard": "leego-design-ui",
  "version": "2.18.0",
  "updated": "2026-10-04",
  "designReadRequiredFields": [
    "mode",
    "platform",
    "primaryUser",
    "primaryTask",
    "successCriteria",
    "templateIds",
    "protectedElements",
    "subtractionTargets",
    "openDecisions"
  ],
  "elementPurposes": [
    "context",
    "decision",
    "action",
    "state-risk",
    "evidence",
    "accessibility"
  ],
  "protectedContent": [
    "object-identity",
    "scope-and-time",
    "risk-conclusion",
    "data-freshness",
    "permission-context",
    "evidence-source",
    "error-recovery",
    "required-help",
    "legal-and-safety"
  ],
  "rules": [
    {
      "id": "UI-DIRECTION-001",
      "category": "intake",
      "severity": "P1",
      "automated": false,
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md#项目设计方向",
      "message": "已有系统继承项目方向；仅新系统或明确改版推荐方向，不重复批准或改写固定框架。"
    },
    {
      "id": "UI-CONSISTENCY-001",
      "category": "redundancy",
      "severity": "P1",
      "automated": false,
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md#跨页面与完整任务路径",
      "message": "同名指标、单位、格式、状态及图表系列映射跨页面一致；先查漂移根因再修复。"
    },
    {
      "id": "UI-EVIDENCE-001",
      "category": "interaction",
      "severity": "P0",
      "automated": false,
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md#两类检查与证据",
      "message": "视觉与任务评审和技术检查分开记录通过/失败/未验证/不适用；登记数和构建成功不能代替验收证据。"
    },
    {
      "id": "shell-internal-alignment",
      "category": "shell",
      "severity": "P1",
      "automated": true,
      "message": "固定12/8/28/8几何，图标轴34、文字轴56；主操作、品牌和无图标同槽，状态偏差≤1 CSS px。",
      "checkMethod": "browser",
      "checker": "scripts/test-sidebar-geometry.mjs"
    },
    {
      "id": "overlay-visible-bounds",
      "category": "shell",
      "severity": "P0",
      "automated": true,
      "message": "按应用与可见视口交集持续定位；收纳固定左、账号锚定入口、详情固定右，窗口/侧栏/滚动/内容变化不越界。",
      "checkMethod": "browser",
      "checker": "scripts/test-sidebar-geometry.mjs"
    },
    {
      "id": "shell-hit-target-overlap",
      "category": "accessibility",
      "severity": "P0",
      "automated": true,
      "message": "独立44px图标热区不能重叠或嵌套；尾部操作不得覆盖相邻导航，浮层焦点不可丢失。",
      "checkMethod": "browser",
      "checker": "scripts/test-sidebar-geometry.mjs"
    },
    {
      "id": "UI-SESSION-001",
      "category": "interaction",
      "severity": "P0",
      "automated": false,
      "message": "退出与会话过期必须映射真实能力，覆盖成功、失败重试和安全返回；不把 toast 或前端布尔值当认证。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-SESSION-002",
      "category": "redundancy",
      "severity": "P1",
      "automated": false,
      "message": "账号与全局操作单点归属；带侧栏 Web 账号和通知在侧栏底部，设置和退出在账号浮层，顶栏仅上下文与搜索；Mobile 在我的页，Pad 使用专用账号入口。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-SESSION-003",
      "category": "shell",
      "severity": "P1",
      "automated": true,
      "message": "登录表单400px上限、48px控件、16px字段间距；演示状态不连接真实后台。",
      "checkMethod": "static",
      "checker": "scripts/validate-ui-standard.mjs"
    },
    {
      "id": "UI-INTAKE-001",
      "category": "intake",
      "severity": "P0",
      "automated": false,
      "message": "进入设计前必须完成 UI-ready 判断；不得询问仓库中可发现的事实。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-INTAKE-002",
      "category": "intake",
      "severity": "P1",
      "automated": false,
      "message": "缺少关键决策时每轮只询问 1–3 个问题，并给出推荐答案。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-REDUNDANCY-001",
      "category": "redundancy",
      "severity": "P0",
      "automated": true,
      "message": "固定工作顶栏下不得出现重复 PageHeader、英文眉题、大标题和用途介绍。",
      "checkMethod": "static",
      "checker": "scripts/validate-ui-standard.mjs"
    },
    {
      "id": "UI-REDUNDANCY-002",
      "category": "redundancy",
      "severity": "P1",
      "automated": false,
      "message": "同一 KPI、全局操作或筛选不得在同一视觉路径重复表达。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-REDUNDANCY-003",
      "category": "redundancy",
      "severity": "P1",
      "automated": false,
      "message": "没有独立层级作用的嵌套卡片、边框、背景和阴影应删除或合并。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-TYPOGRAPHY-001",
      "category": "typography",
      "severity": "P0",
      "automated": true,
      "message": "所有可见文字不得低于 12px。",
      "checkMethod": "static",
      "checker": "scripts/validate-ui-standard.mjs"
    },
    {
      "id": "UI-TYPOGRAPHY-002",
      "category": "typography",
      "severity": "P0",
      "automated": true,
      "message": "字重只允许 400、500、600、700。",
      "checkMethod": "static",
      "checker": "scripts/validate-ui-standard.mjs"
    },
    {
      "id": "UI-ICON-001",
      "category": "icon",
      "severity": "P1",
      "automated": true,
      "message": "全局导航不得使用未登记的 Unicode 或 Emoji 字符代替通用图标。",
      "checkMethod": "static",
      "checker": "scripts/validate-ui-standard.mjs"
    },
    {
      "id": "UI-ICON-002",
      "category": "icon",
      "severity": "P1",
      "automated": false,
      "message": "图标必须遵循 24×24 网格、1.75px 线宽、规定尺寸和所在表面颜色。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-SHELL-001",
      "category": "shell",
      "severity": "P0",
      "automated": true,
      "message": "企业 Web 工作台侧栏、顶栏和内容间距必须匹配固定令牌。",
      "checkMethod": "static",
      "checker": "scripts/validate-ui-standard.mjs"
    },
    {
      "id": "UI-INTERACTION-001",
      "category": "interaction",
      "severity": "P0",
      "automated": false,
      "message": "启用状态的控件必须有真实行为或明确原型反馈。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-INTERACTION-002",
      "category": "interaction",
      "severity": "P1",
      "automated": true,
      "message": "禁止 transition: all；只声明实际发生变化的属性。",
      "checkMethod": "static",
      "checker": "scripts/validate-ui-standard.mjs"
    },
    {
      "id": "UI-INTERACTION-003",
      "category": "interaction",
      "severity": "P1",
      "automated": false,
      "message": "可复用组件应覆盖 Default、Hover、Focus-visible、Active、Disabled、Loading、Error、Success。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-ACCESSIBILITY-001",
      "category": "accessibility",
      "severity": "P0",
      "automated": false,
      "message": "纯图标按钮必须有可访问名称和至少 44px 的触控热区。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "UI-ACCESSIBILITY-002",
      "category": "accessibility",
      "severity": "P0",
      "automated": false,
      "message": "简化不得删除风险、权限、数据新鲜度、错误恢复和必要帮助。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "shell-single-account",
      "category": "shell",
      "severity": "P0",
      "automated": true,
      "message": "带侧栏桌面系统账号和通知仅归属侧栏底部，顶栏不复制身份或退出。",
      "checkMethod": "static",
      "checker": "scripts/validate-ui-standard.mjs"
    },
    {
      "id": "shell-top-panel-toggle",
      "category": "shell",
      "severity": "P1",
      "automated": true,
      "message": "折叠控制固定顶部，20px 面板图标、44px 热区；交界控制已弃用。",
      "checkMethod": "browser",
      "checker": "scripts/test-sidebar-geometry.mjs"
    },
    {
      "id": "overlay-context-focus",
      "category": "accessibility",
      "severity": "P0",
      "automated": false,
      "message": "抽屉和账号浮层隔离焦点，Esc/遮罩关闭并恢复；原生及自定义可聚焦控件均不能遗漏。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    },
    {
      "id": "shell-reversible-motion",
      "category": "interaction",
      "severity": "P0",
      "automated": false,
      "message": "快速反向不排队、不卸载任务或输入；保持草稿、选择、搜索和滚动，减少动态时取消位移。",
      "checkMethod": "review",
      "checker": "UI_DELIVERY_WORKFLOW_2026.md"
    }
  ]
}
